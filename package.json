{
  "name": "@markup-carve/carve-wysiwyg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hosted WYSIWYG editor for the Carve markup language (Tiptap + carve-grammars + carve-js)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:pins": "node scripts/check-carve-pins.mjs"
  },
  "dependencies": {
    "@markup-carve/carve": "github:markup-carve/carve-js#2dc3232e426a93ce40ffe3b099c0bb8731fd25e7",
    "@markup-carve/carve-grammars": "github:markup-carve/carve-grammars#7ef51b6ae5f7eff2556d90d8aa64b78d03a92b0f",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-code-block": "^2.11.5",
    "@tiptap/extension-highlight": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-subscript": "^2.11.5",
    "@tiptap/extension-superscript": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "highlight.js": "^11.11.1",
    "prismjs": "^1.29.0"
  },
  "devDependencies": {
    "happy-dom": "^20.11.2",
    "typescript": "^5.7.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
