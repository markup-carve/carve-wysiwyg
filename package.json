{
  "name": "@markup-carve/carve-wysiwyg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hosted WYSIWYG editor for the Carve markup language (Tiptap + carve-grammars + carve-js)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:pins": "node scripts/check-carve-pins.mjs"
  },
  "dependencies": {
    "@markup-carve/carve": "github:markup-carve/carve-js#6706ff83c405f354ef6412683eb3c26140034ef7",
    "@markup-carve/carve-css": "^0.1.8",
    "@markup-carve/carve-grammars": "github:markup-carve/carve-grammars#7814b9f0a92deb0aaef8441168085e614fc73690",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-code-block": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-subscript": "^3.31.4",
    "@tiptap/extension-superscript": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-table-cell": "^3.31.4",
    "@tiptap/extension-table-header": "^3.31.4",
    "@tiptap/extension-table-row": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "highlight.js": "^11.11.1",
    "katex": "^0.19.0",
    "lowlight": "^3.3.0",
    "mermaid": "12.1.0",
    "prismjs": "^1.29.0"
  },
  "devDependencies": {
    "happy-dom": "^20.11.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@markup-carve/carve": "$@markup-carve/carve"
  }
}
